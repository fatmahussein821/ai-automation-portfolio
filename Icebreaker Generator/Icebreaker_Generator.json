      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        656,
        480
      ],
      "id": "98063e0a-59bf-4691-b710-320171f4b5a5",
      "name": "Google Gemini Chat Model",
      "credentials": {
