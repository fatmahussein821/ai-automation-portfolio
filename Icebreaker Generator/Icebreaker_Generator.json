    {
      "parameters": {
        "jsCode": "// هات النص من الـ input\nlet text = $input.first().json.text \n  || $input.first().json.output \n  || $input.first().json.icebreaker \n  || $input.first().json.message \n  || JSON.stringify($input.first().json);\n\n// لو النص جوه JSON، استخرج الـ icebreaker\ntry {\n  const parsed = JSON.parse(text);\n  if (parsed.icebreaker) {\n    text = parsed.icebreaker;\n  }\n} catch (e) {}\n\n// تنظيف النص\ntext = text\n  .replace(/^[\"']|[\"']$/g, '')          // شيل علامات التنصيص من الأول والآخر\n  .replace(/\\\\n/g, '\\n')                // حول \\n لسطر جديد حقيقي\n  .replace(/\\\\\"/g, '\"')                 // شيل الـ escape من علامات التنصيص\n  .replace(/\\\\t/g, '  ')                // حول التاب لمسافات\n  .replace(/\\n{3,}/g, '\\n\\n')           // شيل الأسطر الفاضية الزيادة\n  .replace(/icebreaker/gi, '')          // شيل كلمة icebreaker\n  .replace(/^\\s*[:\\-\\s]+/gm, '')        // شيل أي رموز زيادة في بداية السطور\n  .trim();\n\n// رجع النص النضيف\nreturn [\n  {\n    json: {\n      cleaned_message: text\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
