        }
      }
    },
    {
      "parameters": {
        "jsCode": "// نجيب النص من رد الـ AI\nconst aiResponse = $input.first().json.response?.generations?.[0]?.[0]?.text \n                || $input.first().json.text \n                || $input.first().json.output \n                || JSON.stringify($input.first().json);\n\n// نحاول نلاقي الـ JSON جوه الرد\nlet links = [];\n\ntry {\n  // نشيل أي markdown أو كلام زيادة\n  const jsonMatch = aiResponse.match(/\\{[\\s\\S]*\\}/);\n  \n  if (jsonMatch) {\n    const parsed = JSON.parse(jsonMatch[0]);\n    links = parsed.links || parsed.Links || [];\n  }\n} catch (e) {\n  // لو فشل الـ parse، نحاول نستخرج الروابط يدوياً\n  const urlRegex = /https?:\\/\\/[^\\s\"'<>]+/g;\n  links = aiResponse.match(urlRegex) || [];\n}\n\n// الدومين الأساسي (هنحاول نجيبُه من أول رابط كامل)\nlet baseUrl = \"https://www.johnsoncontrols.com\";\n\nconst fullLink = links.find(link => link.startsWith(\"http\"));\nif (fullLink) {\n  try {\n    const url = new URL(fullLink);\n    baseUrl = url.origin; // مثلاً https://www.johnsoncontrols.com\n  } catch (e) {}\n}\n\n// ننظف الروابط ونكمل النسبية منها\nlinks = [...new Set(links)]\n  .map(link => {\n    link = String(link).replace(/[.,)\\]]+$/, \"\").trim();\n\n    // لو الرابط نسبي (بيبدأ بـ /)\n    if (link.startsWith(\"/\")) {\n      return baseUrl + link;\n    }\n\n    // لو مفيش http في أوله\n    if (!link.startsWith(\"http\")) {\n      return \"https://\" + link;\n    }\n\n    return link;\n  })\n  .filter(link => link.length > 10 && link.includes(\"http\"))\n  .slice(0, 3); // ناخد أحسن 3 بس\n\nreturn {\n  json: {\n    links: links,\n    link1: links[0] || null,\n    link2: links[1] || null,\n    link3: links[2] || null,\n    count: links.length,\n    baseUrl: baseUrl\n  }\n};"
      },
