      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const record = item.json;\n  const fields = record.fields;\n  \n  const today = DateTime.now();\n  const dueDate = DateTime.fromISO(fields.DueDate);\n  const daysLeft = Math.ceil(dueDate.diff(today, 'days').days);\n  \n  let dueMessage;\n  if (daysLeft > 0) {\n    dueMessage = `خلال ${daysLeft} يوم`;\n  } else if (daysLeft === 0) {\n    dueMessage = `اليوم`;\n  } else {\n    dueMessage = `متأخرة منذ ${Math.abs(daysLeft)} يوم`;\n  }\n  \n  return {\n    json: {\n      id: record.id,\n      InvoiceID: fields.InvoiceID,\n      Customer: fields.Customer,\n      Email: fields.Email,\n      Amount: fields.Amount,\n      Status: fields.Status,\n      DueDate: fields.DueDate,\n      DueDateFormatted: dueDate.toFormat('dd-MM-yyyy'),\n      daysLeft: daysLeft,\n      dueMessage: dueMessage\n    }\n  };\n});"
      },
