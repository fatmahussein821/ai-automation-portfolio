        "jsCode": "const items = $input.all();\nconst cleaned = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data) continue;\n\n  const phone = data.phone || data.phoneUnformatted;\n\n  // لو مفيش رقم تليفون، عدّي المكان ده ومتضيفهوش\n  if (!phone) continue;\n\n  cleaned.push({\n    \"Place name\": data.title || data.name || null,\n    \"Category name\": data.categoryName || data.category || null,\n    \"total Score\": data.totalScore || data.total_score || data.rating || null,\n    \"Count reviews\": data.reviewsCount || data.reviews_count || data.reviewCount || null,\n    \"Street\": data.street || null,\n    \"city\": data.city || null,\n    \"Phone\": `'${phone}`,\n    \"URL\": data.url || data.mapsUrl || null\n  });\n}\n\nreturn cleaned.map(row => ({ json: row }));"
