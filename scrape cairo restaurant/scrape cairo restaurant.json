        "jsCode": "// New cleaned data\nconst newItems = $('Code in JavaScript').all().map(item => item.json);\n\n// Old data from Google Sheets\nconst existingItems = $('Get row(s) in sheet').all().map(item => item.json);\n\n// Create keys from existing data\nconst existingKeys = new Set();\nfor (const item of existingItems) {\n  const name = (item[\"Company Name\"] || item[\"Place name\"] || \"\").toLowerCase().trim();\n  const phone = (item[\"Phone\"] || \"\").toLowerCase().trim();\n  existingKeys.add(`${name}|${phone}`);\n}\n\n// Filter only new ones\nconst uniqueNew = [];\nfor (const item of newItems) {\n  const name = (item[\"Place name\"] || \"\").toLowerCase().trim();\n  const phone = (item[\"Phone\"] || \"\").toLowerCase().trim();\n  const key = `${name}|${phone}`;\n\n  if (name && !existingKeys.has(key)) {\n    uniqueNew.push(item);\n    existingKeys.add(key); // prevent duplicates inside the new batch too\n  }\n}\n\nreturn uniqueNew.map(item => ({ json: item }));"
      },
