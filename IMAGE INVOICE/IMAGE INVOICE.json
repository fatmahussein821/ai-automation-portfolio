    {
      "parameters": {
        "jsCode": "const aiText = $input.first().json.output || $input.first().json.text || \"\";\n\nconst result = {\n  name: \"\",\n  email: \"\",\n  phone: \"\",\n  invoice_number: \"\",\n  amount: \"\",\n  currency: \"\",\n  date: \"\",\n  due_date: \"\",\n  description: \"\",\n  address: \"\",\n  company: \"\",\n  original_text: aiText\n};\n\n// دالة مساعدة لاستخراج القيمة\nfunction extract(fieldNames) {\n  for (const name of fieldNames) {\n    // بيجيب اللي بعد Found as \"....\"\n    const regex1 = new RegExp(`\\\\*\\\\*${name}\\\\*\\\\*[\\\\s\\\\S]*?Found as\\\\s*\"([^\"]+)\"`, \"i\");\n    const match1 = aiText.match(regex1);\n    if (match1) return match1[1].trim();\n\n    // لو مكتوب Not present\n    const regex2 = new RegExp(`\\\\*\\\\*${name}\\\\*\\\\*[\\\\s\\\\S]*?Not present`, \"i\");\n    if (aiText.match(regex2)) return \"\";\n\n    // طريقة تانية أبسط\n    const regex3 = new RegExp(`\\\\*\\\\*${name}\\\\*\\\\*[\\\\s\\\\:]*([^\\\\n*]+)`, \"i\");\n    const match3 = aiText.match(regex3);\n    if (match3) {\n      let val = match3[1].replace(/Found as/i, \"\").replace(/\"/g, \"\").trim();\n      if (val && !val.toLowerCase().includes(\"not present\")) return val;\n    }\n  }\n  return \"\";\n}\n\n// استخراج الحقول\nresult.invoice_number = extract([\"invoice_id\", \"invoice number\", \"invoice\", \"رقم الفاتورة\"]);\nresult.name           = extract([\"customer\", \"name\", \"اسم المشترك\", \"العميل\"]);\nresult.email          = extract([\"email\", \"ايميل\", \"البريد\"]);\nresult.phone          = extract([\"phone\", \"موبايل\", \"تليفون\", \"رقم\"]);\nresult.amount         = extract([\"amount\", \"total\", \"الإجمالي\", \"المبلغ\", \"المستحق\"]);\nresult.currency       = extract([\"currency\", \"عملة\"]);\nresult.date           = extract([\"issue_date\", \"date\", \"تاريخ\", \"تاريخ الإصدار\"]);\nresult.due_date       = extract([\"due_date\", \"due date\", \"تاريخ الاستحقاق\"]);\nresult.description    = extract([\"description\", \"وصف\", \"البيان\"]);\nresult.address        = extract([\"address\", \"عنوان\"]);\nresult.company        = extract([\"company\", \"شركة\"]);\n\n// تنظيف المبلغ من أي حروف زيادة\nif (result.amount) {\n  result.amount = result.amount.replace(/[^\\d.]/g, \"\");\n}\n\nreturn result;"
      },
